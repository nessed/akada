# ---------------------------------------------------------------------------
# Akada environment variables
#
# Copy to .env.local for development. Set the same values in the Vercel
# dashboard for both the Production and Preview environments.
#
# Only NEXT_PUBLIC_* variables are readable by the browser. Never add the
# Supabase service_role key here or anywhere else in this repo — the app is
# RLS-only by design and does not need it.
# ---------------------------------------------------------------------------

# REQUIRED. Supabase project URL.
# Supabase dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED. Supabase publishable key (new format, "sb_publishable_...") or
# the legacy anon JWT. Both work — the client passes the string straight
# through as the apikey header, verified against @supabase/supabase-js
# 2.104. Safe to expose: it is sent to every browser and carries no
# privileges beyond your RLS policies.
# Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# REQUIRED in production. The canonical origin, no trailing slash. Drives
# metadataBase (OG/Twitter tags), robots.txt and sitemap.xml. Getting this
# wrong makes social previews point at localhost.
NEXT_PUBLIC_SITE_URL=https://akada.example.com

# REQUIRED only for the Claude/Akada MCP connector. This is server-only: do
# not prefix it with NEXT_PUBLIC_. Generate a unique value of at least 32
# characters for each deployed environment, for example with:
# openssl rand -base64 48
AKADA_MCP_TOKEN_SECRET=replace-with-a-long-random-secret

# OPTIONAL, development only. Runs the app entirely off localStorage with no
# Supabase backend. Ignored in production builds: a production build with the
# Supabase variables missing fails rather than silently storing user data in
# the browser.
# NEXT_PUBLIC_USE_LOCAL_DATA=true
